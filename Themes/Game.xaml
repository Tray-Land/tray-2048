<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Game palette. The board and the two smallest tiles follow the flyout's theme so they sit
        quietly on the acrylic; from 8 upward every tile is its own bright gradient, cool colors
        climbing to warm ones, and 2048 is gold.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#14304070" />
            <SolidColorBrush x:Key="BoardStrokeBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="EmptyCellBrush" Color="#12304070" />
            <SolidColorBrush x:Key="TileStrokeBrush" Color="#14000000" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F0F7F8FB" />

            <LinearGradientBrush x:Key="Tile2Background" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#EEF1F8" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Tile2Foreground" Color="#3A4358" />
            <LinearGradientBrush x:Key="Tile4Background" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#E9EEFF" />
                <GradientStop Offset="1" Color="#D5DFFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Tile4Foreground" Color="#2C3A66" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="BoardStrokeBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="EmptyCellBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="TileStrokeBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F01F2230" />

            <LinearGradientBrush x:Key="Tile2Background" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#5C6688" />
                <GradientStop Offset="1" Color="#4A5373" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Tile2Foreground" Color="#E8ECF6" />
            <LinearGradientBrush x:Key="Tile4Background" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#7076C4" />
                <GradientStop Offset="1" Color="#5A5FAE" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Tile4Foreground" Color="#EEF1FF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="TileLightForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileGoldForeground" Color="#4A3300" />

    <!--  Sky  -->
    <LinearGradientBrush x:Key="Tile8Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6FD6FF" />
        <GradientStop Offset="1" Color="#2FA4F2" />
    </LinearGradientBrush>
    <!--  Blue  -->
    <LinearGradientBrush x:Key="Tile16Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5B8CFF" />
        <GradientStop Offset="1" Color="#3A5CF0" />
    </LinearGradientBrush>
    <!--  Violet  -->
    <LinearGradientBrush x:Key="Tile32Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#8E72FF" />
        <GradientStop Offset="1" Color="#6344EC" />
    </LinearGradientBrush>
    <!--  Purple  -->
    <LinearGradientBrush x:Key="Tile64Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#C764FF" />
        <GradientStop Offset="1" Color="#9A36E6" />
    </LinearGradientBrush>
    <!--  Pink  -->
    <LinearGradientBrush x:Key="Tile128Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF72B9" />
        <GradientStop Offset="1" Color="#EC3F8C" />
    </LinearGradientBrush>
    <!--  Coral  -->
    <LinearGradientBrush x:Key="Tile256Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF8170" />
        <GradientStop Offset="1" Color="#F04A3A" />
    </LinearGradientBrush>
    <!--  Orange  -->
    <LinearGradientBrush x:Key="Tile512Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFA94F" />
        <GradientStop Offset="1" Color="#F57A16" />
    </LinearGradientBrush>
    <!--  Amber  -->
    <LinearGradientBrush x:Key="Tile1024Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFD04A" />
        <GradientStop Offset="1" Color="#F6A300" />
    </LinearGradientBrush>
    <!--  Gold  -->
    <LinearGradientBrush x:Key="Tile2048Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFF08A" />
        <GradientStop Offset="0.55" Color="#FFD23F" />
        <GradientStop Offset="1" Color="#FFB300" />
    </LinearGradientBrush>
    <!--  Beyond: mint, then midnight  -->
    <LinearGradientBrush x:Key="Tile4096Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#3EE8B4" />
        <GradientStop Offset="1" Color="#00AE8A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileSuperBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#3B3F6B" />
        <GradientStop Offset="1" Color="#1C1E3A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WinTitleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFB300" />
        <GradientStop Offset="0.5" Color="#FF72B9" />
        <GradientStop Offset="1" Color="#8E72FF" />
    </LinearGradientBrush>

    <!--  A soft top sheen shared by every tile, so they read as pieces rather than flat squares.  -->
    <LinearGradientBrush x:Key="TileSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#33FFFFFF" />
        <GradientStop Offset="0.5" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <Style x:Key="EmptyCellStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource EmptyCellBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="ScorePillStyle" TargetType="Grid">
        <Setter Property="Padding" Value="12,6,12,8" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--  No BasedOn: StaticResource can't reliably reach a sibling merged dictionary.  -->
    <Style x:Key="ScoreLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="ScoreValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
