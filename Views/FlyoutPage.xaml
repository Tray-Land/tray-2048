<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tray2048.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Tray2048.Views"
    Background="Transparent"
    PreviewKeyDown="Page_PreviewKeyDown">

    <Page.Resources>
        <!--  "+8" floats up out of the score and fades.  -->
        <Storyboard x:Name="ScoreGainStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ScoreGainTransform"
                Storyboard.TargetProperty="Y"
                From="4"
                To="-22"
                Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScoreGainText" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Name="NewBestStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BestPillTransform" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.08">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase Amplitude="0.6" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BestPillTransform" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.08">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase Amplitude="0.6" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                FontFamily="Segoe UI Variable Display"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{StaticResource WinTitleBrush}"
                Text="2048" />
            <Button
                x:Name="UndoButton"
                Grid.Column="1"
                AutomationProperties.Name="Undo"
                Click="UndoButton_Click"
                IsEnabled="False"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Undo (Ctrl+Z)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Z" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                <FontIcon FontSize="14" Glyph="&#xE7A7;" />
            </Button>
            <Button
                x:Name="NewGameButton"
                Grid.Column="2"
                AutomationProperties.Name="New game"
                Click="NewGameButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="New game (Ctrl+N)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                x:Name="SettingsButton"
                Grid.Column="3"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Scores  -->
        <Grid
            Grid.Row="1"
            Margin="0,0,4,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Style="{StaticResource ScorePillStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ScoreLabelStyle}" Text="Score" />
                    <TextBlock
                        x:Name="ScoreText"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource ScoreValueStyle}"
                        Text="0" />
                </StackPanel>
                <TextBlock
                    x:Name="ScoreGainText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="ScoreGainTransform" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <Grid
                Grid.Column="1"
                RenderTransformOrigin="0.5,0.5"
                Style="{StaticResource ScorePillStyle}">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BestPillTransform" />
                </Grid.RenderTransform>
                <StackPanel>
                    <TextBlock
                        x:Name="BestLabel"
                        Style="{StaticResource ScoreLabelStyle}"
                        Text="Best" />
                    <TextBlock
                        x:Name="BestText"
                        Style="{StaticResource ScoreValueStyle}"
                        Text="0" />
                </StackPanel>
                <FontIcon
                    x:Name="BestIcon"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE734;" />
            </Grid>
        </Grid>

        <views:GameBoard
            x:Name="Board"
            Grid.Row="2"
            Margin="0,0,4,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <TextBlock
            Grid.Row="3"
            Margin="0,0,4,0"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Use the arrow keys or swipe to join tiles"
            TextWrapping="Wrap" />
    </Grid>
</Page>
